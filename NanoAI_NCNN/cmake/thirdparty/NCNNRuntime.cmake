include_guard(GLOBAL)

set(_NANOAI_NCNN_DEFAULT_NCNN_INCLUDE_DIR "")
set(_NANOAI_NCNN_DEFAULT_NCNN_LIBRARY_DIR "")

set(NANOAI_NCNN_NCNN_INCLUDE_DIR "${_NANOAI_NCNN_DEFAULT_NCNN_INCLUDE_DIR}" CACHE PATH "NCNN include directory")
set(NANOAI_NCNN_NCNN_LIBRARY_DIR "${_NANOAI_NCNN_DEFAULT_NCNN_LIBRARY_DIR}" CACHE PATH "NCNN library directory")
set(NANOAI_NCNN_NCNN_LIBRARY "ncnn" CACHE STRING "NCNN library name")

if(NANOAI_NCNN_WITH_NCNN)
    if(NANOAI_NCNN_NCNN_INCLUDE_DIR STREQUAL "" OR NANOAI_NCNN_NCNN_LIBRARY_DIR STREQUAL "")
        message(FATAL_ERROR
            "NCNN dependency is enabled but paths are not set. "
            "Please provide -DNANOAI_NCNN_NCNN_INCLUDE_DIR and -DNANOAI_NCNN_NCNN_LIBRARY_DIR."
        )
    endif()

    list(APPEND NANOAI_NCNN_INCLUDE_DIRS ${NANOAI_NCNN_NCNN_INCLUDE_DIR})
    list(APPEND NANOAI_NCNN_LINK_DIRS ${NANOAI_NCNN_NCNN_LIBRARY_DIR})
    list(APPEND NANOAI_NCNN_LINK_LIBS ${NANOAI_NCNN_NCNN_LIBRARY})
endif()
